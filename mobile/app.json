{
  "expo": {
    "name": "ONLIST",
    "slug": "onlist",
    "version": "1.1.0",
    "orientation": "portrait",
    "icon": "./assets/onlist/app-icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "club.onlist.app",
      "buildNumber": "22",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "club.onlist.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/onlist/app-icon.png",
        "backgroundColor": "#020202"
      },
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/onlist/ONLIST Logo_Favicon A.png"
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "ONLIST a besoin d'accéder à vos photos pour votre profil."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/onlist/ONLIST Logo_Favicon A.png",
          "color": "#C9A961",
          "sounds": []
        }
      ],
      "expo-font",
      "expo-web-browser",
      [
        "expo-camera",
        {
          "cameraPermission": "ONLIST a besoin de la caméra pour scanner les QR codes d'accès aux événements."
        }
      ],
      "expo-video",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#000000",
          "resizeMode": "cover"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "d5f3cae3-defe-4df4-8d54-ed7d6c921e9a"
      }
    }
  }
}
