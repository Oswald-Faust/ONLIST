PORT=4000
NODE_ENV=production
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/onlist
JWT_SECRET=change-me-to-a-long-random-secret
# --- Stripe (abonnements business) ---
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_PUBLISHABLE_KEY=pk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
STRIPE_PRICE_STARTER=price_xxx
STRIPE_PRICE_PRO=price_xxx
STRIPE_PRICE_GROUP=price_xxx
STRIPE_PUBLIC_BASE_URL=https://onlist.club
# Optionnel : STRIPE_SUCCESS_URL, STRIPE_CANCEL_URL, STRIPE_PORTAL_RETURN_URL
ALLOWED_ORIGINS=https://onlist.club,https://www.onlist.club,https://admin.onlist.club,https://api.onlist.club,http://localhost:3000,http://localhost:8081

# SMTP (pour les emails de réinitialisation de mot de passe)
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=hello@onlist.club
SMTP_PASS=your-email-password
